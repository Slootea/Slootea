# Development Caddyfile
# For production, replace localhost with your domain

localhost {
    # Frontend routes
    handle /* {
        reverse_proxy frontend:3000
    }

    # API routes
    handle /api/* {
        reverse_proxy backend:3001
    }
}

# Production example (uncomment and modify for your domain)
