# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=appointment_user
DATABASE_PASSWORD=appointment_pass
DATABASE_NAME=appointment_db

# ===========================================
# Clerk Authentication
# ===========================================
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# ===========================================
# Encryption Keys (for secure token storage)
# Generate with: openssl rand -hex 32
# ===========================================
WHATSAPP_TOKEN_ENCRYPTION_KEY=your_32_byte_hex_encryption_key
EMAIL_TOKEN_ENCRYPTION_KEY=your_32_byte_hex_encryption_key
SMS_TOKEN_ENCRYPTION_KEY=your_32_byte_hex_encryption_key

# ===========================================
# Twilio SMS Configuration (Optional)
# Used as fallback when organization settings are not configured
# ===========================================
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
# TWILIO_PHONE_NUMBER=+1234567890
META_APP_ID=your_facebook_app_id
META_APP_SECRET=your_facebook_app_secret
META_OAUTH_REDIRECT_URI=https://yourapi.com/api/auth/meta/callback
FRONTEND_URL=https://yourfrontend.com